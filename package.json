{
  "name": "phials-plugin-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/watch.ts",
    "build": "tsx scripts/sync-manifest.ts && vite build",
    "validate": "tsx scripts/validate-dist.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev:install": "tsx scripts/dev-install.ts",
    "sdk:sync": "tsx scripts/sdk.ts sync",
    "sdk:verify": "tsx scripts/sdk.ts verify",
    "test:run": "tsx --test tests/*.test.ts",
    "version:set": "tsx scripts/version-set.ts",
    "release:inventory": "tsx scripts/release-inventory.ts",
    "release:verify": "tsx scripts/release-verify.ts"
  },
  "devDependencies": {
    "@iconify/svelte": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tsconfig/svelte": "^5.0.4",
    "phoundry-ui": "^0.1.40",
    "shiki": "^4.0.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
